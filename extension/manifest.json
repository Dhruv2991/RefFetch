{
  "manifest_version": 3,
  "name": "RefFetch",
  "version": "1.0.0",
  "key": "",
  "description": "Save papers from arXiv straight into your RefFetch research library — one click to summarize, tag, and cross-reference.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "RefFetch"
  },
  "permissions": ["activeTab", "identity", "storage"],
  "host_permissions": [
    "https://reffetch.onrender.com/*",
    "https://drfbsatxkyvrvxcmwpau.supabase.co/*",
    "https://arxiv.org/*"
  ]
}